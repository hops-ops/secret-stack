# code: language=yaml
#
# Output XR status
#

{{- $xr := getCompositeResource . }}
{{- $s := $state.status }}
---
apiVersion: {{ $xr.apiVersion }}
kind: {{ $xr.kind }}
status:
  ready: {{ $s.ready }}
  backend: {{ $s.backend }}
  secretStore:
    name: {{ $s.secretStore.name }}
    scope: {{ $s.secretStore.scope }}
    ready: {{ $s.secretStore.ready }}
  {{- if $s.vault }}
  vault:
    releaseName: {{ $s.vault.releaseName }}
    namespace: {{ $s.vault.namespace }}
    ready: {{ $s.vault.ready }}
  {{- end }}
